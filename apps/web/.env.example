# Required on Vercel and any production deployment.
# Public origin of the Vraunix API; the web app proxies /api/* to this origin.
API_INTERNAL_URL=https://vraunixwebsite-api.onrender.com

# Optional. Keep the default to use the same-origin /api/v1 proxy, which is
# required for cookie and CSRF behavior.
# NEXT_PUBLIC_API_BASE=/api/v1
