# ---------------------------------------------------------------------------
# Vraunix Studio environment configuration
# Copy to `.env` in the repository root for the API. Never commit real secrets.
# For the web app, create apps/web/.env.local for production overrides if needed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://127.0.0.1:4000
PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/vraunix_studio
MONGODB_DATABASE=vraunix_studio

# Sessions / CSRF (use at least 32 random bytes in production)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=vx_session
SESSION_TTL_HOURS=8
CSRF_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=false

# Initial administrator (only used by `npm run seed:admin`)
INITIAL_ADMIN_NAME=Vraunix Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password-12-plus-chars

# Email (optional in development; not configured means delivery is skipped and reported honestly)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Vraunix Studio <no-reply@vraunix.example>"

# Storage for generated PDFs (local is the only implemented provider)
STORAGE_PROVIDER=local
STORAGE_DIR=storage

# Payment gateway (manual payments are implemented; no gateway is bundled)
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Rate limits (per IP)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_DISCOVERY_MAX=5
RATE_LIMIT_CONTACT_MAX=5
